// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Durable queue for webhook ingestion (NFR-6, NFR-9). Every inbound webhook is
// persisted here before processing so it can be retried after a crash or a
// downstream (e.g. partner) failure, deduplicated via Shopify's webhook id,
// and traced end-to-end via correlationId.
model WebhookEvent {
  id            String    @id @default(cuid())
  webhookId     String    @unique // Shopify's X-Shopify-Webhook-Id header; enforces idempotency
  topic         String
  shop          String
  correlationId String
  payload       Json
  status        String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  attempts      Int       @default(0)
  lastError     String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  nextAttemptAt DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([shop])
}

// --- Core domain model (SRS Section 6) -------------------------------------

model Merchant {
  id                    String    @id @default(cuid())
  shop                  String    @unique
  planTier              String    @default("free")
  selectedCategories    String[] // niche categories chosen during onboarding (FR-1.3)
  defaultMarkupType     String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  defaultMarkupValue    Decimal   @default(0) @db.Decimal(10, 2)
  notificationEmail     String? // where FR-8.1 emails are sent; set from the notifications inbox
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  products      Product[]
  orders        Order[]
  partners      MerchantPartner[]
  notifications MerchantNotification[]
  markupRules   MarkupRule[]
}

// Which partners a merchant connected during onboarding (FR-1.3) or later
// (FR-7.1 self-serve equivalent for v1 -- see Phase 2 flags).
model MerchantPartner {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  connectedAt DateTime @default(now())

  @@unique([merchantId, partnerId])
}

// In-app merchant notifications (FR-2.5 here; also used by FR-8.1 in a later
// phase for routing failures / SLA breaches / new niche products).
model MerchantNotification {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  type       String // OUT_OF_STOCK | DISCONTINUED | ROUTING_FAILURE | SLA_BREACH | NEW_PRODUCTS
  message    String
  metadata   Json?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([merchantId, read])
}

// A fulfillment partner/warehouse. Credentials/config for whichever adapter
// backs it (REST, SFTP, ...) are encrypted at rest (NFR-4) -- see
// app/partners/config.server.ts.
model Partner {
  id                  String   @id @default(cuid())
  partnerKey          String   @unique // looks up the concrete adapter in app/partners/registry.server.ts
  name                String
  integrationType     String // REST | SFTP | MOCK
  pricingFeedFormat   String   @default("API") // API | CSV | MANUAL -- how the partner publishes pricing/catalog updates (FR-7.1)
  supportedCategories String[]
  regions             String[]
  slaHours            Int
  shippingEstimate    Decimal  @default(0) @db.Decimal(10, 2) // flat estimated shipping cost per order (FR-3.2 simplification -- see Phase 3 flags)
  apiConfigEncrypted  String? // AES-256-GCM encrypted JSON (adapter-specific config/credentials)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  products         Product[]
  routingDecisions RoutingDecision[]
  fulfillments     Fulfillment[]
  merchants        MerchantPartner[]
  catalogSkus      PartnerCatalogSku[]
}

model Product {
  id               String   @id @default(cuid())
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id])
  partnerId        String
  partner          Partner  @relation(fields: [partnerId], references: [id])
  shopifyProductId String
  partnerSku       String // primary/first variant's partner SKU; full mapping is in variantMap
  category         String
  variantMap       Json // { [shopifyVariantId]: partnerSku } (FR-2.2)
  baseCost         Decimal  @db.Decimal(10, 2)
  status           String   @default("ACTIVE") // ACTIVE | OUT_OF_STOCK | DISCONTINUED (FR-2.4/FR-2.5)
  mockupUrl        String? // most recently generated mockup (FR-2.3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  markupRule MarkupRule?

  @@unique([merchantId, shopifyProductId])
  @@index([partnerId])
}

// Markup overrides (FR-3.1). Precedence at resolution time is
// PRODUCT > CATEGORY > Merchant.defaultMarkupType/Value -- see
// app/catalog/pricing.server.ts#resolveMarkupRule.
model MarkupRule {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  scope      String // CATEGORY | PRODUCT
  category   String? // set when scope = CATEGORY
  productId  String?  @unique // set when scope = PRODUCT
  product    Product? @relation(fields: [productId], references: [id])
  type       String // PERCENTAGE | FIXED
  value      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, category])
  @@index([merchantId])
}

model Order {
  id                  String   @id @default(cuid())
  merchantId          String
  merchant            Merchant @relation(fields: [merchantId], references: [id])
  shopifyOrderId      String
  lineItems           Json // snapshot of line items at order-creation time
  shippingAddress     Json?
  shippingCountryCode String? // denormalized from shippingAddress for routing's region check
  status              String   @default("PENDING_ROUTING") // PENDING_ROUTING | SUBMITTED | PARTIALLY_SUBMITTED | ROUTING_FAILED | CANCELLED
  correlationId       String? // carried from the triggering webhook's WebhookEvent, threaded through every routing/fulfillment/tracking log for this order (NFR-9)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  routingDecisions RoutingDecision[]
  fulfillments     Fulfillment[]
  disputes         Dispute[]

  @@unique([merchantId, shopifyOrderId])
}

// One routing decision per shipment-group (line items sharing a candidate
// partner) per Order -- an audit trail of what the engine chose and why, plus
// merchant overrides (FR-4.2). Distinct from Fulfillment, which tracks actually
// *submitting* that decision to the partner and its retries (FR-4.5).
model RoutingDecision {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  partnerId        String?
  partner          Partner? @relation(fields: [partnerId], references: [id])
  lineItems        Json // the specific order line items this decision covers
  reasonCode       String // e.g. LOWEST_COST | NO_CANDIDATES | OUT_OF_STOCK | NO_REGION_MATCH | MERCHANT_OVERRIDE
  costEstimate     Decimal? @db.Decimal(10, 2)
  slaEstimateHours Int?
  isOverride       Boolean  @default(false) // true when a merchant manually forced this partner (FR-4.2)
  createdAt        DateTime @default(now())

  fulfillment Fulfillment?

  @@index([orderId])
}

// The execution/submission unit (FR-4.3/FR-4.4/FR-4.5): one per shipment-group.
// Durable-queue shaped like WebhookEvent (status/attempts/lastError/
// nextAttemptAt) so submission failures retry with backoff instead of being
// lost, and a partner outage degrades to "queued for retry" (NFR-3/NFR-6).
model Fulfillment {
  id                  String           @id @default(cuid())
  orderId             String
  order               Order            @relation(fields: [orderId], references: [id])
  partnerId           String
  partner             Partner          @relation(fields: [partnerId], references: [id])
  routingDecisionId   String?          @unique
  routingDecision     RoutingDecision? @relation(fields: [routingDecisionId], references: [id])
  lineItems           Json
  partnerOrderId      String?
  trackingNumber      String?
  carrier             String?
  status              String           @default("PENDING_SUBMISSION") // PENDING_SUBMISSION | QUEUED | IN_PRODUCTION | SHIPPED | DELIVERED | FAILED
  attempts            Int              @default(0)
  lastError           String?
  nextAttemptAt       DateTime         @default(now())
  shippedAt           DateTime?
  slaBreachNotifiedAt DateTime? // set once an SLA_BREACH notification has fired, so polling doesn't re-notify (FR-8.1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  disputes Dispute[]

  @@index([orderId])
  @@index([status, nextAttemptAt])
}

model Dispute {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id])
  fulfillmentId    String?
  fulfillment      Fulfillment? @relation(fields: [fulfillmentId], references: [id])
  type             String // DAMAGED | MISPRINT | LOST
  status           String       @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | REJECTED
  details          String?
  partnerDisputeId String? // the partner's own reference, from PartnerAdapter#submitDispute (FR-6.1)
  resolution       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
}

// Tracks which partner-catalog SKUs have already been seen, so
// app/catalog/new-products.server.ts only notifies merchants about ones that
// are genuinely new (FR-8.1) instead of flooding notifications for the whole
// existing catalog on first run -- see prisma/seed.ts, which seeds this
// alongside each Partner so "new" means "new since the app was set up".
model PartnerCatalogSku {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  sku         String
  category    String
  firstSeenAt DateTime @default(now())

  @@unique([partnerId, sku])
}
