# Shopify app credentials (from `shopify app config link` / Partners dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_inventory,write_inventory,read_shipping,write_metaobjects,write_metaobject_definitions
SHOPIFY_APP_URL=https://example.com
# SHOP_CUSTOM_DOMAIN=

# Postgres connection used by Prisma (see docker-compose.yml for local dev)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/fast_node?schema=public

# 32-byte key (base64) used to encrypt partner credentials / secrets at rest (NFR-4).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# How often an external scheduler should run `npm run inventory:sync` (FR-2.4).
INVENTORY_SYNC_INTERVAL_MINUTES=15

# Platform fee shown in the cost breakdown, as a percent of selling price (FR-3.2).
APP_FEE_PERCENT=5

# SMTP connection used to email merchant notifications (FR-8.1). Works with any
# provider that exposes SMTP creds (SES, SendGrid, Mailgun, Postmark, ...).
# Leave both unset to disable email -- notifications still land in-app.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# NOTIFICATIONS_FROM_EMAIL=notifications@yourapp.example.com

# HTTP Basic Auth credentials gating /admin/* (platform admin -- FR-7.1/FR-7.3).
# Leave unset to disable /admin/* entirely (it 503s rather than opening unauthenticated).
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
